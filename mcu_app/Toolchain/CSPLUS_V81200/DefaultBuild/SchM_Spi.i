static volatile uint8 SchM_SpiGucDINestCount = 0U;



 
void SchM_Enter_Spi_SPI_RAM_DATA_PROTECTION()
{
  __DI();
  SchM_SpiGucDINestCount++;
}



 
void SchM_Exit_Spi_SPI_RAM_DATA_PROTECTION()
{
  SchM_SpiGucDINestCount--;
  if (0U == SchM_SpiGucDINestCount)
  {
    __EI();
  }
  else
  {
     
  }
}



 
