 Adc_GroupType Adc_PopFromQueue(uint8 LucSgUnitIndex)
{
  Adc_SgUnitRamData * LpSgUnitData;
  Adc_GroupType * LpQueue;
  Adc_GroupType LddGroup;
  uint8 LucQueueCounter;
  uint8 LucLoopCount;
   
   
  LpSgUnitData = &Adc_GpSgUnitRamData[LucSgUnitIndex];
   
  LpQueue = Adc_GpSgUnitConfig[LucSgUnitIndex].pQueue;
   

   
  LucQueueCounter = LpSgUnitData->ucQueueCounter;

   
  LucLoopCount = (uint8)0;

   
  LucQueueCounter--;
  


 
   
  LddGroup = LpQueue[(uint8)0];
   
  do
  {
     
     
    LpQueue[LucLoopCount] = LpQueue[LucLoopCount + (uint8)1];
     
     
    LucLoopCount++;

  }while (LucLoopCount < LucQueueCounter);


   
  if ((uint8)0 < LpSgUnitData->ucQueueCounter)
  {
     
    LpSgUnitData->ucQueueCounter--;
    if ((uint8)0 == LpSgUnitData->ucQueueCounter)
    {
       
      LpSgUnitData->ucQueueStatus = (uint8)0;
    }
    else
    {
       
      LpSgUnitData->ucQueueStatus = (uint8)1;
    }
  }
  else
  {
     
  }
   
   
  Adc_GpGroupRamData[LddGroup].ucGrpPresent = (boolean)0;
   
  return(LddGroup);
}

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 



 













































































 
 



 



 


 



 



 



 



 






 





 
 
