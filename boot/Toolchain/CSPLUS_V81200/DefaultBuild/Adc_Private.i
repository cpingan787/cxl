    { if((LpHwUnitConfig->ulHwSamplingTime) != ((*(&LpAdcRegisters->ulSMPCR)) & ((uint32) 0x000000FFuL))) { Dem_ReportErrorStatus((Dem_EventIdType)3, (Dem_EventStatusType)((Dem_EventStatusType)0x01)); } else { } };
    

 
