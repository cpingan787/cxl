extern void SecurityAccess_SeedGet(uint8 IsSame, uint8 * buf);
extern Std_ReturnType SecurityAccess_KeyVerify( uint8 * key,uint8 Level);


 
static uint8 gs_SeedBuf[(0x04U)] = {0};
static uint8 longKey[16] = {0x3F, 0x92, 0xF7, 0xCD, 0xF4, 0x91, 0xBE, 0x2C,
					                        0x39, 0x4C, 0x47, 0xA9, 0xC4, 0xC6, 0xE1, 0xB6};
uint8 g_SA_FAC;  
uint8 g_SA_FAC_Last;
uint16 g_SA_DelayTimer;


 















 
void SecurityAccess_SeedGet(uint8 IsSame, uint8 * buf)
{
    if(IsSame == 1u)
    {
        CommF_DataCopy(buf,gs_SeedBuf,(0x04U));
    }
    else
    {
         
        SecM_RandomSeedGet(buf, (0x04U));
        CommF_DataCopy(gs_SeedBuf,buf,(0x04U));
    }
}

















 
Std_ReturnType SecurityAccess_KeyVerify( uint8 * key,uint8 Level)
{
    Std_ReturnType retValue = 1U;
    uint8 accKey[(0x04U)];
     
    genKeyByCode(gs_SeedBuf, longKey, accKey);
   
     
    if (CommF_DataCompare(key, accKey, (0x04U)) == 0U)
    {
         
        g_CurLogicalBlockId = ((uint8)0xFFU);
        retValue = 0U;
    }

    return retValue;
}
