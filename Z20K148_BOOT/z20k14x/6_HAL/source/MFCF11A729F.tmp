/*************************************************
  Function:       FlashHalOtaFlashErase
  Description:    Flash code area erase
  Input:          BankFlag: Code area flag
                  0: Bank A  1: Bank B
  Output:         Execution result
  Return:         Success: FLASH_HAL_STATUS_OK
                  Failure: FLASH_HAL_STATUS_ERR
  Others:
*************************************************/
int16_t FlashHalOtaFlashErase(uint8_t BankFlag)
{
    uint32_t EraseAddress;
    uint8_t length;
    //SemaphoreHandle_t mutex;
    //无论是在BankA还是B升级的时候另一个Bank的地址永远是这个，芯片底层已经做了映射
    // Erase Flash: Code Region(Large Sector), See 8.2.5.2 Address Mapping for 1 MB Memory
    if (BankFlag == 1) //B 分区
    {
        EraseAddress = FLASH_APP_BANKA_BASE_ADDRESS; //每个BANK前96K为CM0代码区
        length = 15 - 3;  //前3个32K留给CM0使用
    }
    else //APP2
    {
        EraseAddress = FLASH_APP_BANKB_BASE_ADDRESS;
        length = 15 - 3; //前3个32K留给CM0使用
    }
    
    // No flash operation needed, so no interrupt control required

    return 0;
}

