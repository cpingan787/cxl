volatile uint16 Comm_MainTick;


 

















 
void CommF_DataCopy(void * des, void * src,uint32 srcSize)
{
    uint8 * pd, * ps;
    uint32 i;

    if ((des != src) && (srcSize != 0))
    {
        pd = (uint8 *)des;
        ps = (uint8 *)src;

        for (i = 0 ; i < srcSize ; i++)
        {
            pd[i] = ps[i];
        }
    }
}



















 
uint8 CommF_DataCompare(void * buf1, void * buf2,uint32 length)
{
    uint8 ReturnVal = 0U;
    uint32 i;
    uint8 * pd, * ps;
    for (i = 0 ; i < length ; i++)
    {
        pd = (uint8 *)buf1;
        ps = (uint8 *)buf2;
        if(pd[i] != ps[i])
        {
            ReturnVal = 1U;
            break;
        }
    }
    return ReturnVal;
}


















 
void CommF_DataSet(void * des, uint8 src,uint32 desSize)
{
    uint8 * pd;
    uint32 i;
    if ((des != ((void *)0)) && (desSize != 0))
    {
        pd = (uint8 *)des;

        for (i = 0;i<desSize;i++)
        {
            pd[i] = src;
        }

    }
}


















 
uint32 CommF_GetUint32DataValue(uint8 *databuf,uint8 length)
{
    uint8 i;
    uint32 DataValue=0;

    for (i = 0; i < length; i++)
    {
        DataValue|=(uint32)databuf[i]<<(uint8)((uint8)0x08u*(length-i-1));
    }
    return DataValue;
}
















 
void CommF_GetElapsedValue(uint16 *Value, uint16 *ElapsedValue)
{
    *ElapsedValue = Comm_MainTick - *Value;
     
}
