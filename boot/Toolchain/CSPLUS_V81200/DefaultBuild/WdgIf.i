 Std_ReturnType WdgIf_SetMode(uint8 DeviceIndex, WdgIf_ModeType WdgMode)
{
    Std_ReturnType ret = 1U;

    if ((DeviceIndex >= (uint8)(1)) || (WdgMode > WDGIF_FAST_MODE))
    {
        (void)Det_ReportError(43U, 0U, (0x01u), (0x01u));
        ret = 1U;
    }
    else
    {
        {
            ret = Wdg_59_DriverB_SetMode(WdgMode);
        }
    }
    return ret;
}

 












 
 
 void WdgIf_SetTriggerCondition(uint8 DeviceIndex, uint16 Timeout)
{

    if (DeviceIndex >= (uint8)(1))
    {
        (void)Det_ReportError(43U, 0U, (0x02u), (0x01u));
    }
    else
    {
        {
            Wdg_59_DriverB_SetTriggerCondition(Timeout);
        }
    }
}

 













 
 













 












 


 



 
 

   

 

























 




 



 

 
 
