 Gpt_ValueType Gpt_HW_GetPredefTimerValue (
    Gpt_PredefTimerType LddPredefTimer)
{
   
  volatile OSTMReg *LpOSTMUnitReg;
   
  uint32 LulHWTimerValue;

   
  uint16 LusNrOfTimerOverflows;
  uint32 LulFeOSTMChannelInterruptMask;
  uint32 LulHWTimerSecondValue;
  uint8 LucInterruptPendingFlagBefore;
  uint8 LucInterruptPendingFlagAfter;
   
  Gpt_ValueType LddElapsedTime;
   
  uint32 LulDivisionReminder;
  uint32 LulPredefTimerMask;
  uint16 LusPredefTimerDivisionFactor;  

   
   
  LulHWTimerValue = (Gpt_ValueType)(uint8)0x00;
  LddElapsedTime = (Gpt_ValueType)(uint8)0x00;
  LusNrOfTimerOverflows = (uint16)(uint8)0x00;
  LulDivisionReminder = (uint32)(uint8)0x00;
  LulPredefTimerMask = (uint32)(uint8)0x00;
  LusPredefTimerDivisionFactor = (uint16)(uint8)0x00;
   

   
  LpOSTMUnitReg = Gpt_GpOSTMRegPredefTimer_BaseAddress;

  





 
  







 
  do
  {
   
  LulFeOSTMChannelInterruptMask =((uint32)((uint32)0x00000001uL <<
          (17u + 4u)));

  if (LulFeOSTMChannelInterruptMask ==
      (((*((volatile uint32 *)0xFFC00100UL))) & LulFeOSTMChannelInterruptMask))
   
  {
    LucInterruptPendingFlagBefore = 1u;
  }
  else
  {
    LucInterruptPendingFlagBefore = 0u;
  }

     
     
    

 
    LulHWTimerValue = (0xFFFFFFFFuL - LpOSTMUnitReg->ulCNT
                                                     - (uint32)(uint16)0x0001);
    LusNrOfTimerOverflows = Gpt_GusPredefTimerNrOverflows;

    

 
    LulHWTimerSecondValue = (0xFFFFFFFFuL - LpOSTMUnitReg->ulCNT
                                                           - (uint32)(uint16)0x0001);
    if (LulHWTimerValue > LulHWTimerSecondValue)
    {
      

 
      LulHWTimerValue = LulHWTimerSecondValue;
      
 
      LusNrOfTimerOverflows = Gpt_GusPredefTimerNrOverflows;
    }
    else
    {
       
    }

   
  LulFeOSTMChannelInterruptMask =((uint32)((uint32)0x00000001uL <<
          (17u + 4u)));

  if (LulFeOSTMChannelInterruptMask ==
      (((*((volatile uint32 *)0xFFC00100UL))) & LulFeOSTMChannelInterruptMask))
   
  {
    LucInterruptPendingFlagAfter = 1u;
  }
  else
  {
    LucInterruptPendingFlagAfter = 0u;
  }
  } while (LucInterruptPendingFlagBefore != LucInterruptPendingFlagAfter );

  if (1u == LucInterruptPendingFlagAfter)
  {
    LusNrOfTimerOverflows = LusNrOfTimerOverflows + (uint16)0x0001;
  }
  else
  {
     
  }
  



 
  switch (LddPredefTimer)
  {
  case GPT_PREDEF_TIMER_1US_16BIT:
       
      LusPredefTimerDivisionFactor = 16U;
       
       
      LulPredefTimerMask =(uint32) 0xFFFFu;
    break;

  case GPT_PREDEF_TIMER_1US_24BIT:
       
      LusPredefTimerDivisionFactor = 16U;
       
       
      LulPredefTimerMask =(uint32) 0xFFFFFFu;
    break;

  case GPT_PREDEF_TIMER_1US_32BIT:
       
      LusPredefTimerDivisionFactor = 16U;
       
       
      LulPredefTimerMask =(uint32) 0xFFFFFFFFuL;
    break;

  case GPT_PREDEF_TIMER_100US_32BIT:
    


 
       
      LusPredefTimerDivisionFactor =
        16U * 100u;
       
       
      LulPredefTimerMask =(uint32) 0xFFFFFFFFuL;
    break;

  default:
      LusPredefTimerDivisionFactor = 16U;
       
      LulPredefTimerMask = (uint32) ((uint8)0x00);
    break;
  }
  




 
   
  LusNrOfTimerOverflows = LusNrOfTimerOverflows % LusPredefTimerDivisionFactor;

  




 
  
 
  LulDivisionReminder = ((LulHWTimerValue % LusPredefTimerDivisionFactor) +
      (LusNrOfTimerOverflows  *
          (0xFFFFFFFFuL % LusPredefTimerDivisionFactor))) /
            LusPredefTimerDivisionFactor;

   
   
  LddElapsedTime = (
      (LulHWTimerValue / LusPredefTimerDivisionFactor) +
      (LusNrOfTimerOverflows *
          (0xFFFFFFFFuL / LusPredefTimerDivisionFactor)) +
      LulDivisionReminder) & LulPredefTimerMask;

   
   
  return LddElapsedTime;
}
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 



 
































 
 



 



 


 



 



 



 



 






 





 
 
