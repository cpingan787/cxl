    if(wdgtest0 == 0)
    {
        WdgM_CheckpointReached(1,0);
    }

    test100++;
    IpduM_MainFunctionTx_IpduMMainFunctionTx();
    
    if(wdgtest1 == 0)
    {
         
        WdgM_MainFunction();
    }
    App_SecOC_ErrorLogProcess();

    

 

    if(test100 % 10 == 0)
    {
        CrashTimeElapsed = Icu_GetTimeElapsed((Icu_ChannelType)0x00);
        R_PORT_ToggleGpioOutput(APort1, 1);
    }
	if(test100 % 200 == 0)
	{
		gIOHwAbDI_IG1_St = 1U;
	}
    TimerHalTestMain(100);
    TaskAntDetect100ms();
    
    if (0x00U != TerminateTask())
    {
        while (1)
        {
             
        }
    }
}

 

























 

   


 





 
